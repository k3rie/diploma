@model Diploma.Models.DTOs.DefectCreateDto
@{
    ViewBag.Title = Model.PremisesId > 0 ? "Report New Defect" : "Report New Defect";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h4>Report New Defect</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("CreateDefect", "Owner", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(m => m.PremisesId, "Select Premise", new { @class = "font-weight-bold" })
                            @Html.DropDownListFor(m => m.PremisesId,
                                (SelectList)ViewBag.Premises,
                                "-- Select Premise --",
                                new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.PremisesId, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Choose the premise where the defect was found</small>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Title, "Defect Title", new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Title, new
                            {
                                @class = "form-control",
                                placeholder = "E.g., Crack in the wall, Water leak, Broken window...",
                                maxlength = "255"
                            })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                            <small class="form-text text-muted">Provide a short, clear title for the defect</small>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Description, "Detailed Description", new { @class = "font-weight-bold" })
                            @Html.TextAreaFor(m => m.Description, new
                            {
                                @class = "form-control",
                                rows = "5",
                                placeholder = "Describe the defect in detail: what happened, where exactly, when did you notice it, etc."
                            })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Priority, "Priority", new { @class = "font-weight-bold" })
                                    <select asp-for="Priority" class="form-control" name="Priority">
                                        <option value="0">Low</option>
                                        <option value="1" selected>Medium</option>
                                        <option value="2">High</option>
                                        <option value="3">Critical</option>
                                    </select>
                                    @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.DueDate, "Desired Completion Date", new { @class = "font-weight-bold" })
                                    @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new
                                    {
                                        @class = "form-control",
                                        type = "date",
                                        min = DateTime.Now.ToString("yyyy-MM-dd")
                                    })
                                    @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Photos of the Defect</label>
                            <div class="custom-file">
                                <input type="file" name="Photos" multiple accept="image/*" class="custom-file-input" id="photosInput" />
                                <label class="custom-file-label" for="photosInput">Choose photos...</label>
                            </div>
                            <small class="form-text text-muted">You can select multiple photos. Maximum 10MB each.</small>
                            <div id="photoPreview" class="row mt-3"></div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Defects")" class="btn btn-outline-secondary">
                                <i data-lucide="arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i data-lucide="save"></i> Submit Defect
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        // Show selected file names
        document.getElementById('photosInput').addEventListener('change', function(e) {
            var files = e.target.files;
            var label = document.querySelector('.custom-file-label');
            var preview = document.getElementById('photoPreview');

            if (files.length > 0) {
                label.textContent = files.length + ' file(s) selected';

                // Preview images
                preview.innerHTML = '';
                for (var i = 0; i < files.length; i++) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        var col = document.createElement('div');
                        col.className = 'col-md-3 mb-2';
                        col.innerHTML = '<img src="' + e.target.result + '" class="img-thumbnail" style="height: 100px; width: 100%; object-fit: cover;" />';
                        preview.appendChild(col);
                    };
                    reader.readAsDataURL(files[i]);
                }
            } else {
                label.textContent = 'Choose photos...';
                preview.innerHTML = '';
            }
        });
    </script>
}