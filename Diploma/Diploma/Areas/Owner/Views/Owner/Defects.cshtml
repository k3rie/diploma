@model List<Diploma.Models.DTOs.DefectListDto>
@using Diploma.Models
@{
    ViewBag.Title = "My Defects";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Defects</h2>
        <div>
            <a href="@Url.Action("MyPremises")" class="btn btn-outline-primary mr-2">
                <i data-lucide="building"></i> My Premises
            </a>
            <a href="@Url.Action("CreateDefect")" class="btn btn-primary">
                <i data-lucide="plus"></i> Report New Defect
            </a>
        </div>
    </div>

    @Html.Partial("_Alerts")

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i data-lucide="clipboard-list" style="width: 64px; height: 64px; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">No defects found</h4>
            <p class="text-muted">You haven't reported any defects yet.</p>
            <a href="@Url.Action("CreateDefect")" class="btn btn-primary">
                <i data-lucide="plus"></i> Report First Defect
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Premise</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Created</th>
                                <th>Due Date</th>
                                <th>Info</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var defect in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("DefectDetails", new { id = defect.Id })" class="font-weight-bold">
                                            @defect.Title
                                        </a>
                                        <br />
                                        <small class="text-muted">
                                            <i data-lucide="message-square" style="width: 14px; height: 14px;"></i> @defect.CommentCount
                                            <i data-lucide="image" style="width: 14px; height: 14px; margin-left: 8px;"></i> @defect.MediaCount
                                        </small>
                                    </td>
                                    <td>
                                        <strong>@defect.ObjectName</strong>
                                        <br />
                                        <small class="text-muted">
                                            Apt. @defect.PremiseNumber, Floor @defect.Floor
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge badge-@GetStatusClass(defect.Status)">
                                            @defect.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-@GetPriorityClass(defect.Priority)">
                                            @defect.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <small>@defect.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (defect.DueDate.HasValue)
                                        {
                                            <small class="@(defect.DueDate < DateTime.Now && defect.Status != DefectStatus.Confirmed ? "text-danger" : "")">
                                                @defect.DueDate.Value.ToString("dd.MM.yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td>
                                        <small>
                                            @defect.CommentCount comments<br />
                                            @defect.MediaCount photos
                                        </small>
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="@Url.Action("DefectDetails", new { id = defect.Id })"
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                                            </a>
                                            @if (defect.Status == DefectStatus.Created)
                                            {
                                                <a href="@Url.Action("EditDefect", new { id = defect.Id })"
                                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i data-lucide="edit" style="width: 16px; height: 16px;"></i>
                                                </a>
                                            }
                                            @if (defect.Status == DefectStatus.Fixed)
                                            {
                                                using (Html.BeginForm("ConfirmDefectFix", "Owner", new { id = defect.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            title="Confirm Fix"
                                                            onclick="return confirm('Are you sure you want to confirm this defect is fixed?');">
                                                        <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <small class="text-muted">Total: @Model.Count defects</small>
        </div>
    }
</div>

@functions {
    private string GetStatusClass(DefectStatus status)
    {
        switch (status)
        {
            case DefectStatus.Created: return "secondary";
            case DefectStatus.Assigned: return "primary";
            case DefectStatus.InProgress: return "warning";
            case DefectStatus.Fixed: return "info";
            case DefectStatus.Confirmed: return "success";
            case DefectStatus.Rejected: return "danger";
            default: return "secondary";
        }
    }

    private string GetPriorityClass(DefectPriority priority)
    {
        switch (priority)
        {
            case DefectPriority.Low: return "success";
            case DefectPriority.Medium: return "warning";
            case DefectPriority.High: return "danger";
            case DefectPriority.Critical: return "danger font-weight-bold";
            default: return "warning";
        }
    }
}

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}