@model List<Diploma.Models.DTOs.DefectListDto>
@using Diploma.Resources
@using Diploma.Models
@using Diploma.HtmlHelpers
@{
    ViewBag.Title = "My Defects";
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
     new Diploma.Models.BreadCrumb("/Admin/TradeGroup", Localization.Defects)
     };

}

<div class="filter-actions">
    <div class="filter-form"></div>
    <div class="actions">
        <button class="create-btn" onclick="openModal('@Url.Action("CreateDefect", "Owner", new { area = "Owner" })')">
            Report New Defect
        </button>
    </div>
</div>

@Html.Partial("_Alerts")

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i data-lucide="clipboard-list" style="width: 64px; height: 64px; color: #ccc;"></i>
        <h4 class="mt-3 text-muted">No defects found</h4>
        <p class="text-muted">You haven't reported any defects yet.</p>
        <a href="@Url.Action("CreateDefect")" class="create-btn">
            <i data-lucide="plus"></i> Report First Defect
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Premise</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Created</th>
                        <th>Due Date</th>
                        <th>Info</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var defect in Model)
                    {
                        <tr data-url="@Url.Action("DefectDetails", new { id = defect.Id })" style="cursor:pointer">
                            <td>
                                <span>@defect.Title</span>
                                <br />
                                <small class="text-muted">
                                    <i data-lucide="message-square" style="width: 14px; height: 14px;"></i> @defect.CommentCount
                                    <i data-lucide="image" style="width: 14px; height: 14px; margin-left: 8px;"></i> @defect.MediaCount
                                </small>
                            </td>
                            <td>
                                <strong>@defect.ObjectName</strong>
                                <br />
                                <small class="text-muted">
                                    Apt. @defect.PremiseNumber, Floor @defect.Floor
                                </small>
                            </td>
                            <td>
                                <span class="status-badge @GetStatusClass(defect.Status)">
                                    @defect.Status
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @GetPriorityClass(defect.Priority)">
                                    @defect.Priority
                                </span>
                            </td>
                            <td>
                                <small>@defect.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            </td>
                            <td>
                                @if (defect.DueDate.HasValue)
                                {
                                    <small class="@(defect.DueDate < DateTime.Now && defect.Status != DefectStatus.Confirmed ? "text-danger" : "")">
                                        @defect.DueDate.Value.ToString("dd.MM.yyyy")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">-</small>
                                }
                            </td>
                            <td>
                                <small>
                                    @defect.CommentCount comments<br />
                                    @defect.MediaCount photos
                                </small>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <div class="mt-3">
        <small class="text-muted">Total: @Model.Count defects</small>
    </div>
}

<style>
    /* Additional priority badge styles – extends your status-badge classes */
    .priority-low {
        background: rgba(16, 185, 129, 0.1);
        color: var(--positive-color);
    }

    .priority-medium {
        background: rgba(250, 204, 21, 0.15);
        color: var(--yellow-color);
    }

    .priority-high {
        background: rgba(220, 38, 38, 0.1);
        color: var(--danger-color);
    }

    .priority-critical {
        background: rgba(220, 38, 38, 0.2);
        color: var(--danger-color);
        font-weight: bold;
    }

    /* Secondary button (outline style) */
    .secondary-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 12px;
        background: transparent;
        border: 1px solid var(--primary-blue);
        border-radius: 4px;
        color: var(--primary-blue);
        font-size: 13px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .secondary-btn:hover {
            background: var(--primary-blue);
            color: #fff;
            text-decoration: none;
        }

    /* Icon button for table actions */
    .icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px;
        border-radius: 6px;
        background: transparent;
        color: var(--text-color);
        transition: background 0.2s, color 0.2s;
        text-decoration: none;
    }

        .icon-button:hover {
            background-color: var(--menu-hover-bg);
            color: var(--menu-hover-color);
            text-decoration: none;
        }

    /* Align action buttons in table */
    .table table td.actions {
        display: flex;
        gap: 5px;
        justify-content: flex-start;
        flex-wrap: nowrap;
    }

    /* Consistency for links inside table */
    .link-info {
        font-weight: 700;
        color: var(--text-color);
        text-decoration: none;
    }

        .link-info:hover {
            color: var(--primary-blue);
            text-decoration: underline;
        }
</style>

@functions {
    private string GetStatusClass(DefectStatus status)
    {
        switch (status)
        {
            case DefectStatus.Created: return "status-new";
            case DefectStatus.Assigned: return "status-active";
            case DefectStatus.InProgress: return "status-inprocess";
            case DefectStatus.Fixed: return "status-approved";
            case DefectStatus.Confirmed: return "status-active";
            case DefectStatus.Rejected: return "status-rejected";
            default: return "status-new";
        }
    }

    private string GetPriorityClass(DefectPriority priority)
    {
        switch (priority)
        {
            case DefectPriority.Low: return "priority-low";
            case DefectPriority.Medium: return "priority-medium";
            case DefectPriority.High: return "priority-high";
            case DefectPriority.Critical: return "priority-critical";
            default: return "priority-medium";
        }
    }

}

@section Scripts {
    <script>
        lucide.createIcons();

        // Клик по строке таблицы
        document.querySelectorAll('tr[data-url]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                window.location.href = this.getAttribute('data-url');
            });
        });
    </script>
}
