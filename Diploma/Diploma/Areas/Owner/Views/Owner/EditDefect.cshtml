@model Diploma.Models.DTOs.DefectCreateDto
@using Diploma.Models
@using Diploma.Resources
@{
    Layout = "~/Areas/Owner/Views/Shared/_DefectsLayout.cshtml";
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
        new Diploma.Models.BreadCrumb("/Owner/Owner/Defects", Localization.Defects),
        new Diploma.Models.BreadCrumb("/Owner/Owner/Defect", Localization.Edit)
    };
}

@using (Html.BeginForm("EditDefect", "Owner", new { id = ViewContext.RouteData.Values["id"] }, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <section class="section-info">
        <h2>Defect Information</h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="label">Premise</span>
                <span class="value">
                    @Html.DropDownListFor(m => m.PremisesId, (SelectList)ViewBag.Premises, null, new { @class = "form-control", disabled = "disabled" })
                    <small class="form-text text-muted">Premise cannot be changed after creation</small>
                </span>
            </div>
            <div class="info-item">
                <span class="label required-field">@Html.DisplayNameFor(m => m.Title)</span>
                <span class="value">
                    @Html.EditorFor(m => m.Title, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                </span>
            </div>
            <div class="info-item" style="grid-column: span 2;">
                <span class="label">@Html.DisplayNameFor(m => m.Description)</span>
                <span class="value">
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </span>
            </div>
            <div class="info-item">
                <span class="label">@Html.DisplayNameFor(m => m.Priority)</span>
                <span class="value">
                    @Html.EnumDropDownListFor(m => m.Priority, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger" })
                </span>
            </div>
            <div class="info-item">
                <span class="label">@Html.DisplayNameFor(m => m.DueDate)</span>
                <span class="value">
                    @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger" })
                </span>
            </div>
        </div>
    </section>

    <section class="section-info">
        <h2>Photos</h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="label">Add More Photos</span>
                <span class="value">
                    <input type="file" name="Photos" multiple accept="image/*" class="form-control-file" id="photosInput" />
                    <small class="form-text text-muted">You can select multiple photos.</small>
                    <div id="photoPreview" class="row mt-3"></div>
                </span>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a href="@Url.Action("DefectDetails", new { id = ViewContext.RouteData.Values["id"] })" class="btn btn-outline-secondary">
            <i data-lucide="arrow-left"></i> Back
        </a>
        <button type="submit" class="btn-submit">
            <i data-lucide="save"></i> Save Changes
        </button>
    </div>
}