@model List<Diploma.Services.Interfaces.PremiseDto>
@{
    ViewBag.Title = "My Premises";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Premises</h2>
        <a href="@Url.Action("CreateDefect")" class="btn btn-primary">
            <i data-lucide="plus"></i> Report Defect
        </a>
    </div>

    @Html.Partial("_Alerts")

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i data-lucide="building" style="width: 64px; height: 64px; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">No premises assigned</h4>
            <p class="text-muted">You don't have any premises assigned yet. Please contact administrator.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var premise in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Apt. @premise.Number</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@premise.ObjectName</h6>

                            <ul class="list-unstyled">
                                <li><i data-lucide="layers" style="width: 16px; height: 16px;"></i> Floor: @premise.Floor</li>
                                @if (premise.Area.HasValue)
                                {
                                    <li><i data-lucide="maximize" style="width: 16px; height: 16px;"></i> Area: @premise.Area.Value.ToString("F2") m²</li>
                                }
                                <li>
                                    <i data-lucide="alert-triangle" style="width: 16px; height: 16px;"></i>
                                    Defects:
                                    <span class="badge badge-@(premise.DefectCount > 0 ? "warning" : "success")">
                                        @premise.DefectCount
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100">
                                <a href="@Url.Action("CreateDefect", new { premiseId = premise.Id })" class="btn btn-primary btn-sm">
                                    <i data-lucide="plus" style="width: 16px; height: 16px;"></i> Report Defect
                                </a>
                                <a href="@Url.Action("Defects")" class="btn btn-outline-info btn-sm">
                                    <i data-lucide="list" style="width: 16px; height: 16px;"></i> View All
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}