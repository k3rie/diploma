@using Diploma.Models
@model Diploma.Models.DTOs.DefectDetailDto
@{
    ViewBag.Title = "Defect Details - " + Model.Title;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="@Url.Action("Defects")" class="btn btn-outline-secondary">
                ← Back to List
            </a>
            <h2 class="d-inline-block ml-3">@Model.Title</h2>
        </div>
        <div>
            @if (Model.Status == DefectStatus.Created)
            {
                <a href="@Url.Action("EditDefect", new { id = Model.Id })" class="btn btn-primary">
                    ✏️ Edit
                </a>
                using (Html.BeginForm("DeleteDefect", "Owner", new { id = Model.Id }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete this defect?');">
                        🗑️ Delete
                    </button>
                }
            }
            @if (Model.Status == DefectStatus.Fixed)
            {
                using (Html.BeginForm("ConfirmDefectFix", "Owner", new { id = Model.Id }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-lg"
                            onclick="return confirm('Confirm that the defect is fixed?');">
                        ✅ Confirm Fix
                    </button>
                }
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["WarningMessage"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <!-- Main defect info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Defect Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted">Status</label>
                            <div>
                                <span class="badge badge-@GetStatusClass(Model.Status)" style="font-size: 1rem;">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Priority</label>
                            <div>
                                <span class="badge badge-@GetPriorityClass(Model.Priority)" style="font-size: 1rem;">
                                    @Model.Priority
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted">Description</label>
                        <p class="border rounded p-3 bg-light">
                            @(string.IsNullOrEmpty(Model.Description) ? "No description provided" : Model.Description)
                        </p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="text-muted">Created</label>
                            <div>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Due Date</label>
                            <div>
                                @if (Model.DueDate.HasValue)
                                {
                                    var isOverdue = Model.DueDate < DateTime.Now && Model.Status != DefectStatus.Confirmed;
                                    <span class="@(isOverdue ? "text-danger font-weight-bold" : "")">
                                        @Model.DueDate.Value.ToString("dd.MM.yyyy")
                                        @if (isOverdue)
                                        {
                                            <span class="badge badge-danger">Overdue</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Created By</label>
                            <div>@Model.CreatedByUserName</div>
                        </div>
                    </div>

                    @if (Model.AssignedToUserName != null || Model.ContractorCompanyName != null)
                    {
                        <hr />
                        <div class="row">
                            @if (Model.AssignedToUserName != null)
                            {
                                <div class="col-md-6">
                                    <label class="text-muted">Assigned To</label>
                                    <div>@Model.AssignedToUserName</div>
                                </div>
                            }
                            @if (Model.ContractorCompanyName != null)
                            {
                                <div class="col-md-6">
                                    <label class="text-muted">Contractor</label>
                                    <div>@Model.ContractorCompanyName</div>
                                </div>
                            }
                        </div>
                    }

                    @if (Model.ClosedAt.HasValue)
                    {
                        <hr />
                        <div class="row">
                            <div class="col-md-6">
                                <label class="text-muted">Closed At</label>
                                <div>@Model.ClosedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            @if (Model.AcceptedByOwnerAt.HasValue)
                            {
                                <div class="col-md-6">
                                    <label class="text-muted">Accepted By Owner At</label>
                                    <div>@Model.AcceptedByOwnerAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Photos -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Photos (@Model.MediaFiles.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!Model.MediaFiles.Any())
                    {
                        <p class="text-muted">No photos uploaded</p>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var media in Model.MediaFiles)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card">
                                        <img src="@Url.Content("~/Uploads/Defects/" + media.StoredFileName)"
                                             class="card-img-top"
                                             alt="@media.OriginalFileName"
                                             style="height: 200px; object-fit: cover; cursor: pointer;"
                                             onclick="openImage('@Url.Content("~/Uploads/Defects/" + media.StoredFileName)')" />
                                        <div class="card-body p-2">
                                            <small class="text-muted">
                                                @media.OriginalFileName<br />
                                                @media.UploadedAt.ToString("dd.MM.yyyy HH:mm")<br />
                                                <span class="badge @(media.IsBeforeFix ? "badge-warning" : "badge-success")">
                                                    @(media.IsBeforeFix ? "Before Fix" : "After Fix")
                                                </span>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Status History -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Status History</h5>
                </div>
                <div class="card-body">
                    @if (!Model.StatusHistory.Any())
                    {
                        <p class="text-muted">No status changes recorded</p>
                    }
                    else
                    {
                        <div>
                            @foreach (var history in Model.StatusHistory)
                            {
                                <div class="pb-3 mb-3 border-bottom">
                                    <div class="d-flex justify-content-between">
                                        <strong>
                                            <span class="badge badge-@GetStatusClass(history.OldStatus)">@history.OldStatus</span>
                                            →
                                            <span class="badge badge-@GetStatusClass(history.NewStatus)">@history.NewStatus</span>
                                        </strong>
                                        <small class="text-muted">@history.ChangedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <div>
                                        <small>Changed by: @history.ChangedByUserName</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(history.Comment))
                                    {
                                        <div class="mt-1">
                                            <small class="text-muted">@history.Comment</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Premise Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Location</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="text-muted mb-0">Object</label>
                        <div class="font-weight-bold">@Model.ObjectName</div>
                    </div>
                    <div class="mb-2">
                        <label class="text-muted mb-0">Premise</label>
                        <div>@Model.PremiseNumber</div>
                    </div>
                    <div>
                        <label class="text-muted mb-0">Floor</label>
                        <div>@Model.Floor</div>
                    </div>
                </div>
            </div>

            <!-- Comments -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Comments (@Model.Comments.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Comments.Any())
                    {
                        <p class="text-muted">No comments yet</p>
                    }
                    else
                    {
                        foreach (var comment in Model.Comments)
                        {
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between">
                                    <strong>@comment.UserFullName</strong>
                                    <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <p class="mb-0 mt-1">@comment.Message</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Modal -->
<div id="imageModal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.9);">
    <span onclick="closeImage()" style="position: absolute; top: 20px; right: 40px; color: white; font-size: 40px; cursor: pointer;">&times;</span>
    <img id="modalImage" style="margin: auto; display: block; max-width: 90%; max-height: 90%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" />
</div>

@functions {
    private string GetStatusClass(DefectStatus status)
    {
        switch (status)
        {
            case DefectStatus.Created: return "secondary";
            case DefectStatus.Assigned: return "primary";
            case DefectStatus.InProgress: return "warning";
            case DefectStatus.Fixed: return "info";
            case DefectStatus.Confirmed: return "success";
            case DefectStatus.Rejected: return "danger";
            default: return "secondary";
        }
    }

    private string GetStatusClass(string status)
    {
        if (Enum.TryParse(status, out DefectStatus defectStatus))
            return GetStatusClass(defectStatus);
        return "secondary";
    }

    private string GetPriorityClass(DefectPriority priority)
    {
        switch (priority)
        {
            case DefectPriority.Low: return "success";
            case DefectPriority.Medium: return "warning";
            case DefectPriority.High: return "danger";
            case DefectPriority.Critical: return "danger";
            default: return "warning";
        }
    }
}

@section Scripts {
    <script>
        function openImage(src) {
            document.getElementById('imageModal').style.display = 'block';
            document.getElementById('modalImage').src = src;
        }

        function closeImage() {
            document.getElementById('imageModal').style.display = 'none';
        }

        document.getElementById('imageModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeImage();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeImage();
            }
        });
    </script>
}