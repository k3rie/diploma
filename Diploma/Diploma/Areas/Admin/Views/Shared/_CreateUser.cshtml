@model Diploma.Models.User
@{
    Layout = null;
}
<div class="modal-body-content">
    @using (Html.BeginForm("CreateUser", "Admin", FormMethod.Post, new { id = "createUserForm" }))
    {
        @Html.AntiForgeryToken()
        <section class="section-info">
            <h2>Новый пользователь</h2>
            <div class="info-grid">
                <div class="info-item">
                    <span class="label">Логин</span>
                    <span class="value">@Html.TextBoxFor(m => m.UserName, new { @class = "form-control", required = "required" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Пароль</span>
                    <span class="value">@Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control", required = "required" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Полное имя</span>
                    <span class="value">@Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Email</span>
                    <span class="value">@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Телефон</span>
                    <span class="value">@Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Роль</span>
                    <span class="value">@Html.DropDownList("Role", (SelectList)ViewBag.Roles, new { @class = "form-control" })</span>
                </div>
                <div class="info-item">
                    <span class="label">Компания</span>
                    <span class="value">@Html.DropDownList("CompanyId", (SelectList)ViewBag.Companies, "Без компании", new { @class = "form-control" })</span>
                </div>
            </div>
        </section>
        <div class="form-actions-sticky">
            <button type="submit" class="apply-btn"><i data-lucide="save"></i> Сохранить</button>
        </div>
    }
</div>
<script>
    $('#createUserForm').submit(function(e) {
        e.preventDefault();
        $.post($(this).attr('action'), $(this).serialize())
            .done(function(resp) {
                if (resp.success) {
                    closeLastModal();
                    location.reload();
                } else {
                    alert('Ошибка при сохранении');
                }
            })
            .fail(function() { alert('Ошибка сервера'); });
    });
</script>