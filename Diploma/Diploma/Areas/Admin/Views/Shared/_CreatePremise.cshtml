@model Diploma.Models.Premise
@{
    Layout = null;
    var objectId = ViewBag.ObjectId ?? (int)ViewContext.RouteData.Values["objectId"];
}
<div class="modal-body-content">
    @using (Html.BeginForm("CreatePremise", "Admin", FormMethod.Post, new { id = "createPremiseForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("ObjectId", (int)objectId)
        <section class="section-info">
            <h2>Новое помещение</h2>
            <div class="info-grid">
                <div class="info-item"><span class="label">Номер</span><span class="value">@Html.TextBoxFor(m => m.Number, new { @class = "form-control", required = "required" })</span></div>
                <div class="info-item"><span class="label">Этаж</span><span class="value">@Html.TextBoxFor(m => m.Floor, new { @class = "form-control", type = "number", required = "required" })</span></div>
                <div class="info-item"><span class="label">Площадь (м²)</span><span class="value">@Html.TextBoxFor(m => m.Area, new { @class = "form-control", type = "number", step = "0.01" })</span></div>
                <div class="info-item"><span class="label">Владелец</span><span class="value">@Html.DropDownList("OwnerId", (SelectList)ViewBag.Users, "Нет владельца", new { @class = "form-control" })</span></div>
            </div>
        </section>
        <div class="form-actions-sticky">
            <button type="submit" class="apply-btn"><i data-lucide="save"></i> Сохранить</button>
        </div>
    }
</div>
<script>
    $('#createPremiseForm').submit(function(e) {
        e.preventDefault();
        $.post($(this).attr('action'), $(this).serialize())
            .done(function(resp) {
                if (resp.success) {
                    closeLastModal();
                    location.reload();
                } else alert('Ошибка при сохранении');
            })
            .fail(function() { alert('Ошибка сервера'); });
    });
</script>