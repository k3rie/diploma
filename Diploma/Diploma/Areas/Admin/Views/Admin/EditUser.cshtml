@model Diploma.Models.User
@{
    ViewBag.Title = "Редактирование пользователя";
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
        new Diploma.Models.BreadCrumb("/Admin/Admin/Users", "Пользователи"),
        new Diploma.Models.BreadCrumb("", "Редактирование")
    };
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <section class="section-info">
        <h2>Редактирование</h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="label">Логин</span>
                <span class="value">@Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })</span>
            </div>
            <div class="info-item">
                <span class="label">Новый пароль (оставьте пустым, чтобы не менять)</span>
                <span class="value">@Html.Password("PasswordHash", null, new { @class = "form-control" })</span>
            </div>
            <div class="info-item">
                <span class="label">ФИО</span>
                <span class="value">@Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })</span>
            </div>
            <div class="info-item">
                <span class="label">Email</span>
                <span class="value">@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })</span>
            </div>
            <div class="info-item">
                <span class="label">Телефон</span>
                <span class="value">@Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })</span>
            </div>
            <div class="info-item">
                <span class="label">Роль</span>
                <span class="value">@Html.DropDownList("Role", (SelectList)ViewBag.Roles, new { @class = "form-control" })</span>
            </div>
            <div class="info-item">
                <span class="label">Компания</span>
                <span class="value">@Html.DropDownList("CompanyId", (SelectList)ViewBag.Companies, "Без компании", new { @class = "form-control" })</span>
            </div>
        </div>
    </section>
    <div class="form-actions">
        <button type="submit" class="apply-btn"><i data-lucide="save"></i> Сохранить</button>
        <a href="@Url.Action("UserDetails", new { id = Model.Id })" class="btn btn-outline-secondary">Отмена</a>
    </div>
}