@model List<Diploma.Models.ConstructionObject>
@{
    ViewBag.Title = "Объекты строительства";
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
        new Diploma.Models.BreadCrumb("/Admin/Admin/Objects", "Объекты")
    };
}

<div class="filter-actions">
    <div class="filter-form"></div>
    <div class="actions">
        <button class="create-btn" onclick="openModal('@Url.Action("CreateObject")')">
            <i data-lucide="plus"></i> Создать объект
        </button>
    </div>
</div>

<div class="table-responsive">
    <div class="table">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Адрес</th>
                    <th>Застройщик</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td><a href="@Url.Action("ObjectDetails", new { id = obj.Id })">@obj.Name</a></td>
                        <td>@obj.Address</td>
                        <td>@obj.DeveloperCompany.Name</td>
                        <td>
                            <form action="@Url.Action("DeleteObject")" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@obj.Id" />
                                <button type="submit" class="delete-btn" onclick="return confirm('Удалить объект и все помещения?')">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>