@model Diploma.Models.ConstructionObject
@using Diploma.Models
@{
    ViewBag.Title = "Объект: " + Model.Name;
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
        new Diploma.Models.BreadCrumb("/Admin/Admin/Objects", "Объекты"),
        new Diploma.Models.BreadCrumb("", Model.Name)
    };
    var premises = ViewBag.Premises as List<Diploma.Models.Premise>;
}

<section class="section-info">
    <h2>Информация об объекте</h2>
    <div class="info-grid">
        <div class="info-item"><span class="label">Название</span><span class="value">@Model.Name</span></div>
        <div class="info-item"><span class="label">Адрес</span><span class="value">@Model.Address</span></div>
        <div class="info-item"><span class="label">Застройщик</span><span class="value">@Model.DeveloperCompany.Name</span></div>
    </div>
    <div class="mt-3">
        <a href="@Url.Action("EditObject", new { id = Model.Id })" class="create-btn"><i data-lucide="edit"></i> Редактировать</a>
        <form action="@Url.Action("DeleteObject")" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="delete-btn" onclick="return confirm('Удалить объект и все помещения?')"><i data-lucide="trash-2"></i> Удалить</button>
        </form>
    </div>
</section>

<section class="section-info mt-4">
    <h2>Помещения (@premises.Count)</h2>
    <div class="mb-3">
        <button class="create-btn" onclick="openModal('@Url.Action("CreatePremise", new { objectId = Model.Id })')">
            <i data-lucide="plus"></i> Добавить помещение
        </button>
    </div>
    <div class="table-responsive">
        <div class="table">
            <table>
                <thead>
                    <tr><th>Номер</th><th>Этаж</th><th>Площадь</th><th>Владелец</th><th>Действия</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in premises)
                    {
                        <tr>
                            <td>@p.Number</td>
                            <td>@p.Floor</td>
                            <td>@(p.Area?.ToString("F2") ?? "—")</td>
                            <td>@(p.Owner?.FullName ?? "—")</td>
                            <td>
                                <a href="@Url.Action("EditPremise", new { id = p.Id })" class="btn btn-sm btn-outline-primary" title="Редактировать"><i data-lucide="edit"></i></a>
                                <form action="@Url.Action("DeletePremise")" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="objectId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить помещение?')" title="Удалить"><i data-lucide="trash-2"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>