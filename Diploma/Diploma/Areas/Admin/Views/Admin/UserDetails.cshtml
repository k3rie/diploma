@model Diploma.Models.User
@{
    ViewBag.Title = "Пользователь: " + Model.FullName;
    ViewBag.BreadCrumbs = new List<Diploma.Models.BreadCrumb>
{
        new Diploma.Models.BreadCrumb("/Admin/Admin/Users", "Пользователи"),
        new Diploma.Models.BreadCrumb("", Model.UserName)
    };
}

<section class="section-info">
    <h2>Информация о пользователе</h2>
    <div class="info-grid">
        <div class="info-item"><span class="label">Логин</span><span class="value">@Model.UserName</span></div>
        <div class="info-item"><span class="label">ФИО</span><span class="value">@Model.FullName</span></div>
        <div class="info-item"><span class="label">Email</span><span class="value">@Model.Email</span></div>
        <div class="info-item"><span class="label">Телефон</span><span class="value">@Model.Phone</span></div>
        <div class="info-item"><span class="label">Роль</span><span class="value">@Html.DisplayEnumFor(m => m.Role)</span></div>
        <div class="info-item"><span class="label">Компания</span><span class="value">@(Model.Company?.Name ?? "—")</span></div>
    </div>
    <div class="mt-3">
        <a href="@Url.Action("EditUser", new { id = Model.Id })" class="create-btn"><i data-lucide="edit"></i> Редактировать</a>
        <form action="@Url.Action("DeleteUser")" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="delete-btn" onclick="return confirm('Удалить пользователя?')"><i data-lucide="trash-2"></i> Удалить</button>
        </form>
    </div>
</section>